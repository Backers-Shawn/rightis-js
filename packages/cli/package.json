{
  "name": "rightis",
  "version": "0.1.0",
  "description": "Rightis CLI: log in, set up a sandbox key and run your first rights check",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rightis": "./dist/index.js"
  },
  "files": [
