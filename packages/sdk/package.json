{
  "name": "@rightis/sdk",
  "version": "0.1.1",
  "description": "Check identity rights (face, voice, persona) before your AI generates them — Rightis registry SDK",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "generative-ai",
    "likeness",
    "right-of-publicity",
    "deepfake",
    "consent",
    "face",
    "voice",
    "voice-clone",
    "persona",
    "avatar",
    "image-generation",
    "nofakes",
    "identity-rights",
    "rightis",
    "mcp"
  ],
  "homepage": "https://rightis.org/en/developers",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Backers-Shawn/rightis-js.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Backers-Shawn/rightis-js/issues"
  },
  "author": "The Backers Inc."
}
